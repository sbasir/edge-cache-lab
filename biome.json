{
	"$schema": "https://biomejs.dev/schemas/2.4.13/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"apps/web/**/*.ts",
			"apps/web/**/*.tsx",
			"apps/web/**/*.js",
			"apps/web/**/*.mjs",
			"apps/web/**/*.cjs",
			"apps/web/**/*.json",
			"apps/web/**/*.jsonc",
			"!**/node_modules",
			"!**/dist",
			"!apps/web/src/api",
			"!apps/web/worker-configuration.d.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100,
		"lineEnding": "lf"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "always",
			"trailingCommas": "none",
			"arrowParentheses": "always"
		}
	},
	"json": {
		"formatter": {
			"trailingCommas": "none"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"a11y": {
				"useButtonType": "warn"
			},
			"suspicious": {
				"noExplicitAny": "warn"
			},
			"style": {
				"useImportType": "error",
				"noNonNullAssertion": "warn"
			}
		}
	}
}
