# Copy this file to `.env` and fill values (do NOT commit secrets)
# Example .env for Cloudflare DNS helper
CF_API_TOKEN=your_cloudflare_api_token_here
CF_ZONE_ID=your_cloudflare_zone_id_here
CF_API_RECORD_NAME=api.edge.example.com
CF_TTL=300 # 5 minutes
CF_PROXIED=false
# Optional: set DRY_RUN=1 to perform a dry-run of DNS changes
DRY_RUN=1
PULUMI_ACCESS_TOKEN=your_pulumi_access_token_here